<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="handler"
            type="com.a.activity.ACompletionActivity" />
        <variable
            name="vm"
            type="com.a.viewmodel.ACompletionViewModel" />
        <variable
            name="gvm"
            type="com.face.util.GVM" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        bindAddBottomPadding="@{true}"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/a_completion_background">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTitle"
            bindAddTopMargin="@{true}"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/backImg"
                bindSingleClick="@{()->handler.finish()}"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/a_settings_back"
                android:padding="12dp"
                android:src="@mipmap/a_icon_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgNotice"
                bindSingleClick="@{()->handler.onNotice()}"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/dialog_notice"
                android:padding="12dp"
                android:src="@drawable/a_ic_swap_info"
                app:layout_constraintEnd_toStartOf="@id/imgReport"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgReport"
                bindSingleClick="@{()->handler.onReport()}"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/report"
                android:padding="12dp"
                android:src="@drawable/a_ic_swap_report"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/previewFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintBottom_toTopOf="@id/btnVipD"
            app:layout_constraintDimensionRatio="686:987"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clTitle">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgCompletion"
                bindInVisible="@{vm.isShowVideo}"
                bindSingleClick="@{()->handler.toPicture()}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/img_default_m"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/shape_round_24dp"
                app:strokeColor="@null" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView"
                bindVisible="@{vm.isShowVideo}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:cardBackgroundColor="@color/a_completion_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="gone">

                <com.face.video.PauseVideo
                    android:id="@+id/videoFace"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/btnVipD"
            bindSingleClick="@{()->handler.onPointDownload()}"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/a_bg_primary_gradient_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/a_ic_completion_download" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="@string/completion_download"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVipBadge"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:background="@drawable/a_bg_completion_vip"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/a_completion_vip"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/btnVipD"
            app:layout_constraintEnd_toEndOf="@id/btnVipD"
            app:layout_constraintTop_toTopOf="@id/btnVipD" />

        <TextView
            android:id="@+id/retry"
            bindSingleClick="@{()->vm.getData()}"
            bindVisible="@{vm.loadFailed}"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/a_bg_primary_gradient_pill"
            android:gravity="center"
            android:minWidth="100dp"
            android:paddingHorizontal="16dp"
            android:text="@string/retry"
            android:textAppearance="@style/font_16"
            android:textColor="@android:color/black"
            app:layout_constraintBottom_toBottomOf="@id/previewFrame"
            app:layout_constraintEnd_toEndOf="@id/previewFrame"
            app:layout_constraintStart_toStartOf="@id/previewFrame"
            app:layout_constraintTop_toTopOf="@id/previewFrame" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
