<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="handler"
            type="com.a.dialog.ABaseHintDialog" />

        <variable
            name="gvm"
            type="com.face.util.GVM" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp"
        android:background="@drawable/a_bg_dialog"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Disclaimer"
            android:textAppearance="@style/font_16"
            android:textColor="#EEF3FD"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:scrollbars="vertical"
            android:layout_marginHorizontal="24dp"
            android:textSize="12sp"
            android:textColor="#B2B2B2" />


        <TextView
            android:id="@+id/btnConfirm"
            bindSingleClick="@{()->handler.onConfirmClick()}"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:gravity="center"
            android:background="@drawable/a_bg_primary_gradient_pill"
            android:layout_marginTop="20dp"
            android:text="Continue"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</layout>
