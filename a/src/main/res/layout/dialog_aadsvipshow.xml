<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="handler"
            type="com.a.dialog.AAdsVipShowDialog" />

        <variable
            name="gvm"
            type="com.face.util.GVM" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/a_bg_dialog"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/a_ic_ads_unlock"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="26dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/dialog_aads_vip_title"
            android:textAppearance="@style/font_16"
            android:textColor="#ffffff"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img" />

        <TextView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/dialog_aads_vip_context"
            android:textColor="#B2B2B2"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/title" />

        <TextView
            android:id="@+id/txtVip"
            bindSingleClick="@{()->handler.onConfirmClick()}"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/a_bg_primary_gradient_pill"
            android:gravity="center"
            android:text="Watch Ads"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/content" />

        <LinearLayout
            bindSingleClick="@{()->handler.onNoAdsClick()}"
            bindVisible="@{gvm.userInfo.tflops!=0}"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/a_bg_primary_gradient_pill"
            android:gravity="center"
            tools:visibility="visible"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/txtVip">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/no_ads"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUseNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/consume_point"
                android:textColor="#000000"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPoint1"
            bindVisible="@{gvm.userInfo.tflops!=0}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="AIPoints："
            android:textColor="#B2B2B2"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/txtPoint2"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtVip"
            tools:text="AIPoints:"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/txtPoint2"
            bindVisible="@{gvm.userInfo.tflops!=0}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text='@{gvm.userInfo.tflops+""}'
            android:textColor="#B2B2B2"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/txtPoint1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtPoint1"
            app:layout_constraintTop_toTopOf="@+id/txtPoint1"
            tools:text="200" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
