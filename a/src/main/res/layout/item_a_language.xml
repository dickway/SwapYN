<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
    android:paddingHorizontal="14dp" android:paddingVertical="10dp"
    android:gravity="center_vertical" android:orientation="horizontal" android:background="?attr/selectableItemBackground">
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/imgSelected"
        android:layout_width="18dp" android:layout_height="20dp" android:layout_marginEnd="8dp"
        android:src="@drawable/a_ic_settings_check" android:importantForAccessibility="no" />
    <TextView android:id="@+id/tvLanguageName" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="16sp" android:textColor="@android:color/white" />
</LinearLayout>
