<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="handler"
            type="com.a.activity.ASwapActivity" />

        <variable
            name="adapterTab"
            type="com.a.adapter.ASwapTabAdapter" />

        <variable
            name="vm"
            type="com.a.viewmodel.ASwapViewModel" />

        <variable
            name="gvm"
            type="com.face.util.GVM" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        bindAddBottomPadding="@{true}"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/a_swap_background">


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="16dp"
            android:contentDescription="@string/a_swap_preview"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toTopOf="@id/conOperation"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clTitle"
            app:shapeAppearanceOverlay="@style/shape_round_24dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conList"
            bindVisible="@{vm.hasMultipleFaces}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="gone">


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rlTab"
                bindAdapter="@{adapterTab}"
                bindData="@{vm.swapList}"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvComplete"
                app:layout_constraintStart_toStartOf="parent"
                tools:itemCount="2"
                tools:listitem="@layout/item_aswaptab_item" />

            <TextView
                android:id="@+id/tvComplete"
                bindSelected="@{vm.sources}"
                bindSingleClick="@{()->handler.onProductionClick()}"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/a_bg_swap_button"
                android:gravity="center"
                android:drawableStart="@mipmap/a_icon_swapface"
                android:paddingHorizontal="30dp"
                android:drawablePadding="8dp"
                android:text="Swap Face"
                android:textAppearance="@style/font_16"
                android:textColor="@color/a_swap_button_text"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <LinearLayout
                bindVisible="@{vm.isAIPoint}"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="-10dp"
                android:background="@drawable/a_bg_22_r20"
                android:gravity="center"
                android:paddingHorizontal="7dp"
                app:layout_constraintEnd_toEndOf="@+id/tvComplete"
                app:layout_constraintStart_toStartOf="@+id/tvComplete"
                app:layout_constraintTop_toTopOf="@+id/tvComplete">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/img_icon_hash32" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@{vm.usePinot.toString()}"
                    android:textColor="@color/colorWhite"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="100" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <TextView
            android:id="@+id/retry"
            bindSingleClick="@{()->vm.getData()}"
            bindVisible="@{vm.loadFailed}"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/a_btn_w_r8"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Retry"
            android:textAppearance="@style/font_16"
            android:textColor="#000000"
            app:layout_constraintBottom_toBottomOf="@+id/imgCover"
            app:layout_constraintEnd_toEndOf="@+id/imgCover"
            app:layout_constraintStart_toStartOf="@+id/imgCover"
            app:layout_constraintTop_toTopOf="@+id/imgCover"
            app:layout_constraintWidth_min="100dp"
            tools:visibility="visible" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTitle"
            bindAddTopMargin="@{true}"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgBack"
                bindSingleClick="@{()->handler.finish()}"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/a_settings_back"
                android:padding="12dp"
                android:src="@mipmap/a_icon_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgReport"
                bindSingleClick="@{()->handler.onReport()}"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/report"
                android:enabled="@{vm.mediaByBean != null}"
                android:padding="12dp"
                android:src="@drawable/a_ic_swap_report"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgDisclaimer"
                bindSingleClick="@{()->handler.onToAct()}"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/a_swap_disclaimer"
                android:padding="12dp"
                android:src="@drawable/a_ic_swap_info"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imgReport"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgCollect"
                bindSelected="@{vm.isCollect}"
                bindSingleClick="@{()->handler.onCollectClick()}"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@{vm.isCollect ? @string/a_swap_unsave : @string/a_swap_save}"
                android:enabled="@{vm.mediaByBean != null}"
                android:padding="12dp"
                android:src="@drawable/a_checkbox_swap_collect"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imgDisclaimer"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conOperation"
            bindVisible="@{!vm.hasMultipleFaces || vm.isShow}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible">

            <View
                android:id="@+id/view2"
                bindSingleClick="@{()->handler.onToShow()}"
                bindVisible="@{vm.hasMultipleFaces}"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toTopOf="@+id/view1"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/view1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="-12dp"
                android:background="@drawable/a_bg_dialog2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="@+id/view" />

            <View
                android:id="@+id/view"
                android:layout_width="28dp"
                android:layout_height="3dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/a_bg_30_r100"
                app:layout_constraintBottom_toTopOf="@+id/tvN"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvN"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Select face"
                android:textColor="#6F6F6F"
                android:textSize="15sp"
                app:layout_constraintBottom_toTopOf="@+id/lineAdd"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/lineAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@+id/tvComplete2">

                <com.google.android.material.imageview.ShapeableImageView
                    bindSingleClick="@{()->handler.onAddClick()}"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="5dp"
                    android:background="#1AFFFFFF"
                    android:scaleType="center"
                    android:src="@mipmap/a_icon_tab_add"
                    app:shapeAppearanceOverlay="@style/shape_circle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rlChoose"
                    bindAdapter="@{vm.swapAdapter}"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_aswap_item" />
            </LinearLayout>

            <com.face.view.DraLeftBtn
                android:id="@+id/tvComplete2"
                bindSingleClick="@{()->handler.onProductionClick()}"
                android:enabled="@{vm.sources}"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/a_bg_swap_button"
                android:gravity="center"
                android:text="Swap Face"
                android:textAppearance="@style/font_16"
                android:textColor="@color/a_swap_button_text"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
