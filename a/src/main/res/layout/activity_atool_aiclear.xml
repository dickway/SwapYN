<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="handler"
            type="com.a.activity.tool.AClearAiActivity" />

        <variable
            name="vm"
            type="com.a.viewmodel.AClearAiViewModel" />

        <variable
            name="gvm"
            type="com.face.util.GVM" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        bindAddVerticalPadding="@{true}"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorAppBg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTitle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/backImg"
                bindSingleClick="@{()->handler.eixtActivity()}"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:src="@drawable/img_icon_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorWhite" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="85dp"
                android:ellipsize="end"
                android:gravity="center"
                android:text="Image removal"
                android:textAppearance="@style/font_18"
                android:textColor="@color/colorWhite"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.king.drawboard.view.DBV
            android:id="@+id/drawBoardView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/colorAppBg"
            android:src="@drawable/img_default_m"
            app:layout_constraintBottom_toTopOf="@+id/conb"
            app:layout_constraintTop_toBottomOf="@+id/clTitle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/initImg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/drawBoardView"
            app:layout_constraintEnd_toEndOf="@+id/drawBoardView"
            app:layout_constraintStart_toStartOf="@+id/drawBoardView"
            app:layout_constraintTop_toTopOf="@+id/drawBoardView" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2B2B2B"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgUp"
                bindSelected="@{vm.showUp}"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/margin_width_app"
                android:layout_marginBottom="24dp"
                android:src="@drawable/checkbox_tool_up"
                app:layout_constraintBottom_toTopOf="@+id/toolAiTxt"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgNext"
                bindSelected="@{vm.showNext}"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/checkbox_tool_next"
                app:layout_constraintBottom_toTopOf="@+id/toolAiTxt"
                app:layout_constraintStart_toEndOf="@+id/imgUp"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgOriginal"
                bindSelected="@{vm.showOriginacl}"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/checkbox_tool_original"
                app:layout_constraintBottom_toTopOf="@+id/toolAiTxt"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSise"
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="right"
                android:text="@{vm.seekbarNum.toString()}"
                android:textAppearance="@style/font_14"
                android:textColor="#B2B2B2"
                tools:text="23"
                app:layout_constraintBottom_toBottomOf="@+id/toolAiTxt"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/toolAiTxt" />

            <TextView
                android:id="@+id/toolAiTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_width_app"
                android:layout_marginBottom="32dp"
                android:text="Size"
                android:textAppearance="@style/font_14"
                android:textColor="#B2B2B2"
                app:layout_constraintBottom_toTopOf="@+id/linWelcome1"
                app:layout_constraintStart_toStartOf="parent" />

            <SeekBar
                android:id="@+id/seekbar_eraser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:max="100"
                android:maxHeight="4dp"
                android:min="1"
                android:minHeight="4dp"
                android:progress="@{vm.seekbarNum}"
                android:progressDrawable="@drawable/a_bg_tool_progress"
                android:splitTrack="false"
                android:thumb="@mipmap/a_icon_d"
                android:thumbOffset="10dp"
                tools:progress="100"
                app:layout_constraintEnd_toStartOf="@+id/tvSise"
                app:layout_constraintBottom_toBottomOf="@+id/toolAiTxt"
                app:layout_constraintStart_toEndOf="@+id/toolAiTxt"
                app:layout_constraintTop_toTopOf="@+id/toolAiTxt" />

            <LinearLayout
                android:id="@+id/linWelcome1"
                bindSelected="@{vm.showSave}"
                bindSingleClick="@{()->handler.saveBitmap()}"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/checkbox_btn_jb"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    bindSelected="@{gvm.videoFaceList.size()>1}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove"
                    android:textAppearance="@style/font_14"
                    android:textColor="#EEF3FD" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/linWelcome2"
                bindSelected="@{vm.postUrl.length()>0}"
                bindSingleClick="@{()->handler.uptadaImg()}"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="16dp"
                android:background="@drawable/checkbox_btn_2"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/editTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save"
                    android:textAppearance="@style/font_14"
                    android:textColor="#000000" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/retry"
            bindSingleClick="@{()->handler.saveBitmap()}"
            bindVisible="@{vm.loadFailed}"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn1_rounded_corners8"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Retry"
            android:textAppearance="@style/font_16"
            android:textColor="@color/colorBlack"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clTitle"
            app:layout_constraintVertical_bias="0.65"
            app:layout_constraintWidth_min="100dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/loadingView"
            bindVisible="@{vm.loading}"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E60B101C"
            tools:visibility="gone">

            <TextView
                android:id="@+id/checkingNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="0%"
                android:textAppearance="@style/font_14"
                android:textColor="@color/colorWhite"
                app:layout_constraintBottom_toTopOf="@+id/progress"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginHorizontal="47dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/a_bg_tool_progress"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAppearance="@style/font_16"
                android:textColor="@color/colorWhite"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/progress" />

            <TextView
                android:id="@+id/tv1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/margin_width_app"
                android:gravity="center"
                android:text="Generating, please wait…"
                android:textAppearance="@style/font_14"
                android:textColor="#999999"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtTime" />

            <com.face.ad.BannerAdView
                android:id="@+id/adView"
                bindVisible="@{gvm.enableAdAndNotVip}"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="bottom"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_insetEdge="bottom" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>