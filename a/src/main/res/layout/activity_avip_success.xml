<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="handler"
            type="com.a.activity.AVipSuccessActivity" />

        <variable
            name="gvm"
            type="com.face.util.GVM" />

    </data>

    <androidx.core.widget.NestedScrollView
        bindAddVerticalPadding="@{true}"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/a_vip_success_background"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="24dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgSuccess"
                android:layout_width="90dp"
                android:layout_height="77dp"
                android:importantForAccessibility="no"
                android:src="@drawable/a_ic_payment_success"
                app:layout_constraintBottom_toTopOf="@id/tv1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tv1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/a_vip_success_title"
                android:textColor="@color/colorAwhite"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgSuccess" />

            <TextView
                android:id="@+id/tv2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/colorAb2"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/btnLaunch"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv1"
                tools:text="Successfully paid US$14.99" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLaunch"
                style="@style/AWidgetGradientPill.Text"
                bindSingleClick="@{()->handler.finish()}"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@null"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:stateListAnimator="@null"
                android:text="@string/vip_continue"
                android:textAllCaps="false"
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv2"
                app:layout_constraintWidth_max="260dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
