<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable name="handler" type="com.a.dialog.ASwapHintDialog" />
        <variable name="gvm" type="com.face.util.GVM" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/a_swaphint_background"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="24dp">

            <LinearLayout
                android:id="@+id/conExamples"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="94dp"
                    android:layout_height="102dp">

                    <FrameLayout
                        android:layout_width="94dp"
                        android:layout_height="94dp"
                        android:background="@drawable/a_bg_swaphint_correct">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgCorrect"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/clear_facial"
                            android:scaleType="centerCrop"
                            android:src="@drawable/a_swaphint_example_correct"
                            app:shapeAppearanceOverlay="@style/shape_circle" />
                    </FrameLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:importantForAccessibility="no"
                        android:src="@drawable/a_ic_swaphint_correct" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/linIncorrectExamples"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="30dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="top|center_horizontal"
                            android:contentDescription="@string/lateral_face"
                            android:scaleType="centerCrop"
                            android:src="@drawable/a_swaphint_example_profile"
                            app:shapeAppearanceOverlay="@style/shape_circle" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:importantForAccessibility="no"
                            android:src="@drawable/a_ic_swaphint_incorrect" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="top|center_horizontal"
                            android:contentDescription="@string/face_covered"
                            android:scaleType="centerCrop"
                            android:src="@drawable/a_swaphint_example_covered"
                            app:shapeAppearanceOverlay="@style/shape_circle" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:importantForAccessibility="no"
                            android:src="@drawable/a_ic_swaphint_incorrect" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_gravity="top|center_horizontal"
                            android:contentDescription="@string/too_vague"
                            android:scaleType="centerCrop"
                            android:src="@drawable/a_swaphint_example_blurred"
                            app:shapeAppearanceOverlay="@style/shape_circle" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:importantForAccessibility="no"
                            android:src="@drawable/a_ic_swaphint_incorrect" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="42dp"
                    android:layout_marginTop="30dp"
                    android:breakStrategy="simple"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/myface_without_cover"
                    android:textColor="@color/colorAwhite"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnConfirm"
                    bindSingleClick="@{()->handler.onUploadClick()}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="57dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/a_bg_primary_gradient_pill"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minHeight="48dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:text="@string/ok"
                    android:textColor="@color/colorAblack"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
