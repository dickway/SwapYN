<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.youth.banner.Banner
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:banner_auto_loop="true"
            app:banner_infinite_loop="true"
            app:banner_indicator_space="4dp"
            app:banner_indicator_selected_color="#ffffff"
            app:banner_indicator_normal_color="#52FFFFFF"
            app:banner_indicator_normal_width="4dp"
            app:banner_indicator_selected_width="10dp"
            app:banner_loop_time="5000"
            app:banner_indicator_gravity="left"
            app:banner_indicator_marginBottom="10dp"
            app:banner_indicator_radius="2dp"
            app:banner_indicator_height="4dp"
            app:banner_indicator_marginLeft="32dp"
            app:layout_constraintTop_toTopOf="parent" />

<!--        <com.youth.banner.indicator.DrawableIndicator-->
