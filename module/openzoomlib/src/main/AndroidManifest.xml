<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".StandardOpenImageActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:theme="@style/Theme.OpenImageTheme">
            <meta-data
                android:name="notch.config"
                android:value="portrait|landscape" />
            <meta-data
                android:name="android.notch_support"
                android:value="true" />
            <meta-data
                android:name="android.max_aspect"
                android:value="2.2" />
        </activity>
        <activity
            android:name=".FixAndroid12BugActivity"
            android:exported="false"
            android:theme="@style/Theme.OpenImageTheme">
        </activity>
        <provider
            android:name="com.flyjingfish.openimageglidelib.OpenImageGlideInitProvider"
            android:authorities="${applicationId}.OpenImageGlideInitProvider"
            android:exported="false"
            android:initOrder="100"
            android:multiprocess="true" />
    </application>
</manifest>