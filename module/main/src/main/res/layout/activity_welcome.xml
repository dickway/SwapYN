<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="handler"
            type="com.face.main.WelcomeActivity" />

        <variable
            name="vm"
            type="com.face.viewmodel.InitViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/progress"
            style="@android:style/Widget.ProgressBar.Large"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:indeterminate="false"
            app:layout_constraintBottom_toBottomOf="@+id/retry"
            app:layout_constraintStart_toStartOf="@+id/retry"
            app:layout_constraintEnd_toEndOf="@+id/retry"
            app:layout_constraintTop_toTopOf="@+id/retry" />

        <TextView
            android:id="@+id/retry"
            bindSingleClick="@{()->handler.rBtn()}"
            bindVisible="@{vm.loadFailed}"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn1_rounded_corners8"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/retry"
            android:textAppearance="@style/font_16"
            android:textColor="@color/colorBlack"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.65"
            app:layout_constraintWidth_min="100dp" />
        <!-- 3.开屏广告容器区域：-->
        <!-- 注意：该区域高度不得小于400dp。 -->
        <FrameLayout
            android:id="@+id/splash_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>