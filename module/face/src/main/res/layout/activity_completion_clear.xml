<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="handler"
            type="com.face.ui.tclear.ClearCompletionActivity" />

        <variable
            name="vm"
            type="com.face.viewmodel.activity.ClearCompletionViewModel" />

        <variable
            name="gvm"
            type="com.face.util.GVM" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        bindAddVerticalPadding="@{true}"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTitle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/backImg"
                bindSingleClick="@{()->handler.finish()}"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/margin_width_app"
                android:paddingEnd="8dp"
                android:src="@drawable/img_icon_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorWhite" />

            <TextView
                android:layout_width="match_parent"
                android:layout_marginHorizontal="80dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/aiclear_title"
                android:textAppearance="@style/font_18"
                android:textColor="@color/colorWhite"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clTitle">


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgCompletion"
                bindSingleClick="@{()->handler.toPicture()}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginVertical="20dp"
                android:layout_marginHorizontal="@dimen/margin_width_app"
                android:layout_marginTop="20dp"
                android:src="@drawable/img_default_m"
                app:layout_constraintBottom_toTopOf="@+id/imgDownload"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/shape_round_16dp"
                app:strokeColor="@null" />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgAgain"
                bindSingleClick="@{()->handler.onAgain()}"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="64dp"
                android:src="@drawable/img_completion_change"
                app:layout_constraintBottom_toTopOf="@+id/imgDownload"
                app:layout_constraintEnd_toEndOf="parent" />
            <TextView
                android:id="@+id/tvAgain"
                bindSingleClick="@{()->handler.onAgain()}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxWidth="90dp"
                android:text="@string/again"
                android:textColor="@color/colorWhite"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/imgAgain"
                app:layout_constraintStart_toStartOf="@+id/imgAgain"
                app:layout_constraintTop_toBottomOf="@+id/imgAgain" />

            <LinearLayout
                android:id="@+id/imgDownload"
                app:drawableStartCompat="@drawable/img_icon_download"
                bindSingleClick="@{()->handler.download()}"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="48dp"
                android:layout_marginHorizontal="@dimen/margin_width_app_btn"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_btn_swap"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/img_icon_download"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/completion_download"
                    android:textColor="@color/colorWhite"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgHd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:layout_marginEnd="28dp"
                android:src="@drawable/img_swap_pro_m"
                app:layout_constraintEnd_toEndOf="@id/imgDownload"
                app:layout_constraintTop_toTopOf="@+id/imgDownload" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>