<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="handler"
            type="com.face.view.CustomDialog" />

        <variable
            name="gvm"
            type="com.face.util.GVM" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_rem"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="#B2B2B2"
            app:shapeAppearanceOverlay="@style/shape_round_2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/custom_face_swap"
            android:textColor="@color/colorWhite"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/you_can_upload_any_video_pic_to_swap"
            android:textAppearance="@style/font_14"
            android:textColor="#B2B2B2" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/onVideo"
                app:layout_constraintTop_toTopOf="parent"
                bindSingleClick="@{()->handler.onVideo()}"
                android:layout_width="wrap_content"
                android:paddingHorizontal="44dp"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:drawablePadding="8dp"
                android:text="@string/target_video"
                android:background="@drawable/bg_rounded_w_corners12"
                android:textColor="@color/colorWhite"
                android:textSize="15sp"
                android:drawableStart="@drawable/img_custom_icon_video"
                app:layout_constraintEnd_toStartOf="@+id/onPhoto"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/onPhoto"
                bindSingleClick="@{()->handler.onPhoto()}"
                android:layout_width="wrap_content"
                android:paddingHorizontal="44dp"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_height="55dp"
                android:gravity="center"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/img_custom_icon_photo"
                android:text="@string/mian_picture_face"
                android:background="@drawable/bg_rounded_w_corners12"
                android:textColor="@color/colorWhite"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/onVideo" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</layout>
