<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="handler"
            type="com.face.ui.gift.CashActivity" />

        <variable
            name="vm"
            type="com.face.viewmodel.activity.CashViewModel" />

        <variable
            name="gvm"
            type="com.face.util.GVM" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        bindAddBottomMargin="@{true}"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F0F0F">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_cash_view"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTitle"
            bindAddTopHeight="@{true}"
            bindAddTopPadding="@{true}"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amazon_gift_card"
                android:textAppearance="@style/font_18"
                android:textColor="@color/colorWhite"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                bindSingleClick="@{()->handler.finish()}"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/screen_margins_width1"
                android:src="@drawable/img_icon_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorWhite" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:paddingHorizontal="@dimen/screen_margins_width1"
                android:src="@drawable/img_cash_amazonrecord"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorWhite" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clTitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="20dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgAm"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="38dp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintDimensionRatio="1200:724"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/viewPrice"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_1b_corners16"
                    app:layout_constraintTop_toBottomOf="@+id/imgAm" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imgPoint1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:layout_constraintVertical_chainStyle="packed"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/img_point_hash"
                    app:layout_constraintBottom_toTopOf="@+id/txtC"
                    app:layout_constraintStart_toStartOf="@+id/viewPrice"
                    app:layout_constraintTop_toTopOf="@+id/viewPrice" />


                <TextView
                    android:id="@+id/tvPointZ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="3000"
                    android:textColor="@color/colorWhite"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/imgPoint1"
                    app:layout_constraintStart_toEndOf="@+id/imgPoint1"
                    app:layout_constraintTop_toTopOf="@+id/imgPoint1" />

                <TextView
                    android:id="@+id/txtC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/amazon_50"
                    android:textColor="@color/colorWhite"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/viewPrice"
                    app:layout_constraintStart_toStartOf="@+id/imgPoint1"
                    app:layout_constraintTop_toBottomOf="@+id/imgPoint1" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_1b_corners16"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp"
                    app:layout_constraintTop_toBottomOf="@+id/viewPrice">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/benefits_guide"
                        android:textColor="@color/colorWhite"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@+id/tvHintCash"
                        app:layout_constraintStart_toStartOf="@+id/imgPoint1"
                        app:layout_constraintTop_toBottomOf="@+id/tvPointZ" />

                    <TextView
                        android:id="@+id/tvGuide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/cash_txt1"
                        android:textColor="@color/colorWhite"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toTopOf="@+id/tvHintCash"
                        app:layout_constraintStart_toStartOf="@+id/imgPoint1"
                        app:layout_constraintTop_toBottomOf="@+id/tvPointZ" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/clickLat"
            bindSelected="@{vm.isGift()}"
            android:layout_width="match_parent"
            android:background="@drawable/checkbox_cash"
            android:orientation="vertical"
            android:layout_height="52dp"
            bindSingleClick="@{()->handler.onCashClick()}"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginHorizontal="28dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/txtBtn"
                bindSelected="@{vm.isGift()}"
                android:paddingHorizontal="12dp"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:gravity="center"
                android:text="@string/cash_aipoints"
                android:textColor="@color/color_btn_type"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:paddingHorizontal="12dp"
                android:id="@+id/txtBalance"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:gravity="center"
                bindSelected="@{vm.isGift()}"
                android:text="@string/balance_alpoints"
                android:textColor="@color/color_btn_cash"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            bindVisible="@{vm.isGift()}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-10dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/img_cash_btnvip"
            app:layout_constraintEnd_toEndOf="@+id/clickLat"
            app:layout_constraintTop_toTopOf="@+id/clickLat" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>