<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="isSelected"
            type="Boolean" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="60dp"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/con"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgTab"
                android:layout_width="47dp"
                android:layout_height="47dp"
                android:background="@color/colorAppBg"
                android:scaleType="centerCrop"
                android:src="@drawable/img_default_m"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="W,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/shape_circle"
                app:strokeColor="@null" />


            <View
                android:id="@+id/conSelect"
                bindVisible="@{isSelected}"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_swap_corners100"
                app:layout_constraintBottom_toBottomOf="@+id/imgTab"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/imgTab" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgChooesAdd"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="-10dp"
            android:layout_marginEnd="-8dp"
            android:background="@color/colorBgFF3434"
            android:padding="2dp"
            android:src="@drawable/img_swap_add_m"
            app:contentPadding="8dp"
            app:tint="@color/colorWhite"
            app:layout_constraintDimensionRatio="W,1:1"
            app:layout_constraintEnd_toEndOf="@+id/con"
            app:layout_constraintTop_toTopOf="@+id/con"
            app:shapeAppearanceOverlay="@style/shape_circle"
            app:strokeColor="@color/colorBlack"
            app:strokeWidth="2dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgChooes"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="-10dp"
            android:layout_marginEnd="-8dp"
            android:background="@color/colorBlack"
            android:padding="2dp"
            android:src="@drawable/img_default_m"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="W,1:1"
            app:layout_constraintEnd_toEndOf="@+id/con"
            app:layout_constraintTop_toTopOf="@+id/con"
            app:shapeAppearanceOverlay="@style/shape_circle"
            app:strokeColor="@color/colorBlack"
            app:strokeWidth="2dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>