<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.face.viewmodel.activity.UpdateAccountViewModel" />

        <variable
            name="handler"
            type="com.face.ui.accountlogin.UpdateAccountActivity" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        bindAddVerticalPadding="@{true}"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F0F0F">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTitle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgBack"
                bindSingleClick="@{()->handler.finish()}"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/screen_margins_width1"
                android:src="@drawable/img_icon_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="60dp"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:text="@string/change_password"
                android:textAppearance="@style/font_18"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/Confirm"
                bindSingleClick="@{()->handler.onUpdate()}"
                bindSelected="@{vm.enableLogin}"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/screen_margins_width1"
                android:gravity="center"
                android:text="@string/confirm"
                android:textSize="16sp"
                android:textColor="@color/color_account_txt3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <TextView
            android:id="@+id/txt1"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:paddingVertical="21dp"
            android:paddingHorizontal="12dp"
            android:text="@string/current"
            android:textColor="#B2B2B2"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clTitle" />
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/editAccount"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
            android:gravity="center_vertical"
            android:hint="@string/old_password"
            android:maxLength="20"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@={vm.account}"
            android:textColor="#FFFFFF"
            android:textColorHighlight="#FF3434"
            android:textColorHint="#5E5E5E"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txt1"
            app:layout_constraintTop_toTopOf="@+id/txt1"
            app:layout_constraintBottom_toBottomOf="@+id/txt1"/>

        <TextView
            android:id="@+id/txt2"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:paddingVertical="21dp"
            android:paddingHorizontal="12dp"
            android:text="@string/str_new"
            android:textColor="#80FFFFFF"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt1" />


        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/editPwd"
            android:layout_width="0dp"
            android:background="@null"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
            android:gravity="center_vertical"
            android:hint="@string/create_new_password"
            android:inputType="textPassword"
            android:maxLength="20"
            android:layout_marginEnd="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="80dp"
            android:text="@={vm.pwd}"
            android:textColor="#FFFFFF"
            android:textColorHighlight="#FF3434"
            android:textColorHint="#5E5E5E"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txt2"
            app:layout_constraintTop_toTopOf="@+id/txt2"
            app:layout_constraintBottom_toBottomOf="@+id/txt2" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgClose"
            bindSingleClick="@{()->vm.onClearInputClick()}"
            bindVisible="@{vm.pwd!=null&amp;&amp;vm.pwd.length()>0}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:src="@drawable/img_account_delete"
            app:layout_constraintBottom_toBottomOf="@+id/editPwd"
            app:layout_constraintEnd_toStartOf="@+id/imgShow"
            app:layout_constraintTop_toTopOf="@+id/editPwd" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgShow"
            bindSelected='@{vm.passwordVisible}'
            bindSingleClick="@{()->vm.onPasswordVisible()}"
            bindVisible="@{vm.pwd!=null&amp;&amp;vm.pwd.length()>0}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:src="@drawable/checkbox_pwd"
            app:layout_constraintBottom_toBottomOf="@+id/editPwd"
            app:layout_constraintEnd_toEndOf="@+id/editPwd"
            app:layout_constraintTop_toTopOf="@+id/editPwd" />

        <TextView
            android:id="@+id/txt3"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:paddingVertical="21dp"
            android:paddingHorizontal="12dp"
            android:text="@string/retype_new"
            android:textColor="#80FFFFFF"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt2" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/editPwd2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
            android:gravity="center_vertical"
            android:hint="@string/confirm_new_password"
            android:inputType="textPassword"
            android:maxLength="20"
            android:paddingStart="12dp"
            android:paddingEnd="80dp"
            android:text="@={vm.pwd2}"
            android:background="@null"
            android:textColor="#FFFFFF"
            android:textColorHighlight="#FF3434"
            android:textColorHint="#5E5E5E"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/txt3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/txt3"
            app:layout_constraintTop_toTopOf="@+id/txt3" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgClose2"
            bindSingleClick="@{()->vm.onClearInputClick2()}"
            bindVisible="@{vm.pwd2!=null&amp;&amp;vm.pwd2.length()>0}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:src="@drawable/img_account_delete"
            app:layout_constraintBottom_toBottomOf="@+id/editPwd2"
            app:layout_constraintEnd_toStartOf="@+id/imgShow2"
            app:layout_constraintTop_toTopOf="@+id/editPwd2" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgShow2"
            bindSelected='@{vm.passwordVisible2}'
            bindSingleClick="@{()->vm.onPasswordVisible2()}"
            bindVisible="@{vm.pwd2!=null&amp;&amp;vm.pwd2.length()>0}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:src="@drawable/checkbox_pwd"
            app:layout_constraintBottom_toBottomOf="@+id/editPwd2"
            app:layout_constraintEnd_toEndOf="@+id/editPwd2"
            app:layout_constraintTop_toTopOf="@+id/editPwd2" />

        <TextView
            android:id="@+id/txtHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:text="@string/letters_and_numbers_only"
            android:textColor="#5E5E5E"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/editPwd2" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>