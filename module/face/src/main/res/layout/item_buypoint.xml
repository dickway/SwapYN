<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="isSelected"
            type="Boolean" />

        <variable
            name="faceBean"
            type="com.face.bean.AiFaceBean" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        bindSelected="@{isSelected}"
        android:background="@drawable/checkbox_buy_item"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="4dp">

        <TextView
            android:id="@+id/tvPointNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorWhite"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:gravity="bottom|end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="6sp"
            app:autoSizeMaxTextSize="22sp"
            android:layout_marginBottom="1dp"
            app:autoSizeStepGranularity="1sp"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintBottom_toTopOf="@+id/tvPrice"
            app:layout_constraintEnd_toStartOf="@+id/tv2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1000" />

        <TextView
            android:id="@+id/tv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorWhite"
            android:textSize="11sp"
            android:maxLines="1"
            android:gravity="bottom|end"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="3dp"
            android:textStyle="bold"
            android:text="@string/hash_points3"
            app:layout_constraintBottom_toTopOf="@+id/tvPrice"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvPointNum"
            tools:text="@string/hash_points3" />
        <TextView
            android:id="@+id/tvPrice"
            android:layout_marginBottom="1dp"
            android:layout_marginHorizontal="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFCB80"
            android:textSize="12sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/tvPointNum"
            app:layout_constraintBottom_toTopOf="@+id/tv3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="VIP Only USD 28" />
        <TextView
            android:id="@+id/tv3"
            android:layout_marginHorizontal="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8E8E8E"
            android:layout_marginBottom="2dp"
            app:layout_goneMarginTop="6dp"
            android:textSize="12sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/tvPrice"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="USD 18" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>