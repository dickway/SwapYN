<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/layout_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout"
        android:background="@color/colorAppBg"
        android:gravity="center">

        <com.face.videoclips.widget.ZVideoView
            android:id="@+id/video_loader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/colorAppBg">

        <TextView
            android:id="@+id/video_shoot_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="12dp"
            android:gravity="center"
            tools:text=">>>>>>>>>>"
            android:textColor="@color/colorB2"
            android:textSize="12dp" />

        <FrameLayout
            android:id="@+id/video_frames_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/video_shoot_tip"
            android:layout_marginHorizontal="12dp"
            android:paddingTop="12dp"
            android:layout_marginBottom="32dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_btn_w20_corners6" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/video_frames_recyclerView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingTop="3dp"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="20dp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/positionIcon"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@null"
                android:src="@mipmap/icon_seek_bar"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/seekBarLayout"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_gravity="bottom"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:orientation="vertical" />

            </LinearLayout>
        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/video_frames_layout"
            android:visibility="visible">

            <TextView
                android:id="@+id/cancelBtn"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/margin_width_app"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_btn_b10_corners20"
                android:gravity="center"
                android:text="@string/cancel"
                android:textColor="@color/colorWhite"
                android:textSize="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_video_play"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:padding="5dp"
                android:src="@drawable/img_icon_play"
                app:layout_constraintBottom_toBottomOf="@+id/finishBtn"
                app:layout_constraintEnd_toStartOf="@+id/finishBtn"
                app:layout_constraintStart_toEndOf="@+id/cancelBtn"
                app:layout_constraintTop_toTopOf="@+id/finishBtn" />

            <TextView
                android:id="@+id/finishBtn"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/margin_width_app"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_rounded_exper_btn2_corners20"
                android:gravity="center"
                android:text="@string/clips_next"
                android:textColor="@color/colorWhite"
                android:textSize="14dp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </RelativeLayout>
</RelativeLayout>