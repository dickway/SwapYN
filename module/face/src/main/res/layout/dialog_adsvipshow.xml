<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="handler"
            type="com.face.view.AdsVipShowDialog" />

        <variable
            name="gvm"
            type="com.face.util.GVM" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_w_corners24"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_rounded_ads_corners24"
            app:layout_constraintBottom_toBottomOf="@+id/img"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/qclick"
            bindSingleClick="@{()->handler.onQClick()}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:src="@drawable/img_dialog_icon_vip_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:src="@drawable/img_ads_icon_hint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="@string/dialog_ads_vip_title"
            android:textColor="@color/colorBlack"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/img" />

        <TextView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/dialog_ads_vip_context"
            android:textAppearance="@style/font_14"
            android:textColor="@color/colorBlack"
            app:layout_constraintTop_toBottomOf="@+id/title" />

        <TextView
            android:id="@+id/txtVip"
            bindInVisible="@{gvm.userInfo.tflops>=handler.usePinot}"
            bindSingleClick="@{()->handler.onConfirmClick()}"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn1_rounded_corners100"
            android:gravity="center"
            android:text="@string/dialog_ads_watch"
            android:textColor="@color/colorWhite"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/content" />

        <LinearLayout
            bindSingleClick="@{()->handler.onNoAdsClick()}"
            bindVisible="@{gvm.userInfo.tflops>=handler.usePinot}"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_btn1_rounded_corners100"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/txtVip">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/no_ads"
                android:textColor="@color/colorWhite"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUseNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/consume_point"
                android:textColor="@color/colorWhite"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPoint1"
            bindVisible="@{gvm.userInfo.tflops>=handler.usePinot}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/hash_points2"
            android:textColor="@color/color8E"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/txtPoint2"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtVip"
            tools:text="AIPoints:"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/txtPoint2"
            bindVisible="@{gvm.userInfo.tflops>=handler.usePinot}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text='@{gvm.userInfo.tflops+""}'
            android:textColor="@color/color8E"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/txtPoint1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtPoint1"
            app:layout_constraintTop_toTopOf="@+id/txtPoint1"
            tools:text="200" />

        <View
            bindVisible="@{gvm.userInfo.tflops&lt;handler.usePinot}"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:background="@color/colorWhite"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txtPoint1"
            app:layout_constraintTop_toBottomOf="@+id/txtVip" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
