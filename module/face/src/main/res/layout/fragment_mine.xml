<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="handler"
            type="com.face.ui.fragment.MeFragment" />

        <variable
            name="vm"
            type="com.face.viewmodel.fragment.MineViewModel" />

        <variable
            name="gvm"
            type="com.face.util.GVM" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorAppBg">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTitle"
            bindAddTopHeight="@{true}"
            bindAddTopPadding="@{true}"
            android:layout_width="0dp"
            android:layout_height="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/lineSettings"
                bindSingleClick="@{()->handler.onSettingClick()}"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="@dimen/margin_width_app"
                android:src="@drawable/img_mine_icon_set"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorWhite" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            bindRefreshListener="@{()->handler.refresh()}"
            bindRefreshing="@{handler.refreshing}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clTitle">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/clTitle">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="20dp">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/line1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgHead"
                            bindSingleClick="@{()->handler.onIsVipClick()}"
                            android:layout_width="61dp"
                            android:layout_height="61dp"
                            android:gravity="center"
                            android:padding="3dp"
                            android:src="@drawable/img_icon_login"
                            android:textAllCaps="true"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorBlack"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/shape_circle"
                            app:strokeColor="#FFC314"
                            app:strokeWidth="2dp"
                            tools:text="M" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_mine_head_corners100"
                            app:layout_constraintBottom_toBottomOf="@+id/imgHead"
                            app:layout_constraintDimensionRatio="1:1"
                            app:layout_constraintEnd_toEndOf="@+id/imgHead"
                            app:layout_constraintStart_toStartOf="@+id/imgHead"
                            app:layout_constraintTop_toTopOf="@+id/imgHead" />

                        <LinearLayout
                            bindSingleClick="@{()->handler.onIsVipClick()}"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/imgHead"
                            app:layout_constraintTop_toTopOf="parent">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/tvAccountName"
                                    bindTextUnderLine='@{gvm.userInfo.name==""}'
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="marquee"
                                    android:gravity="start"
                                    android:paddingEnd="10dp"
                                    android:singleLine="true"
                                    android:textAppearance="@style/font_18"
                                    android:textColor="@color/colorWhite"
                                    android:textStyle="bold"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    tools:text="" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/meVipPro"
                                    bindSelected="@{gvm.userInfo.isVip()}"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:src="@drawable/checkbox_vip" />

                                <TextView
                                    android:id="@+id/txtLink"
                                    bindSingleClick="@{()->handler.onLoginClick()}"
                                    bindTextUnderLine="@{true}"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:paddingHorizontal="10dp"
                                    android:singleLine="true"
                                    android:text="@string/link_google_account"
                                    android:textAppearance="@style/font_14"
                                    android:textColor="@color/colorFont6"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvAccountTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:singleLine="true"
                                android:textAppearance="@style/font_12"
                                android:textColor="@color/colorB2"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="" />
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/conVip"
                        bindSingleClick="@{()->handler.onVipClick()}"
                        bindVisible="@{!gvm.userInfo.isVip()}"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_mine_vip"
                        app:layout_constraintTop_toBottomOf="@+id/line1">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/img_icon_zuan"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <TextView
                            android:id="@+id/tvVipPro"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="16dp"
                            android:text="@string/mine_become_a_pro_member"
                            android:textAppearance="@style/font_22"
                            android:textColor="@color/colorBlack"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgGou1"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="8dp"
                            android:src="@drawable/img_vip_icon_select"
                            android:tint="@color/colorBlack"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvVipPro" />

                        <TextView
                            android:id="@+id/vipTbg1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:gravity="start"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:maxWidth="200dp"
                            android:text="@string/mine_vip_all_templates3"
                            android:textAppearance="@style/font_11"
                            android:textColor="@color/colorBlack"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@+id/imgGou1"
                            app:layout_constraintStart_toEndOf="@+id/imgGou1"
                            app:layout_constraintTop_toTopOf="@+id/imgGou1" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgGou2"
                            android:layout_width="11dp"
                            bindVisible="@{gvm.isShowTool != 0}"
                            tools:visibility="gone"
                            android:layout_height="11dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/img_vip_icon_select"
                            android:tint="@color/colorBlack"
                            app:layout_constraintStart_toEndOf="@+id/vipTbg1"
                            app:layout_constraintTop_toTopOf="@+id/vipTbg1" />

                        <TextView
                            android:id="@+id/vipTbg2"
                            android:layout_width="0dp"
                            bindVisible="@{gvm.isShowTool != 0}"
                            tools:visibility="gone"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:gravity="start"
                            android:text="@string/mine_vip_all_templates1"
                            android:layout_marginEnd="20dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textStyle="bold"
                            android:textAppearance="@style/font_12"
                            android:textColor="@color/colorBlack"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="@+id/imgGou2"
                            app:layout_constraintStart_toEndOf="@+id/imgGou2"
                            app:layout_constraintTop_toTopOf="@+id/imgGou2" />


                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgGou3"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginTop="5dp"
                            android:src="@drawable/img_vip_icon_select"
                            android:tint="@color/colorBlack"
                            app:layout_constraintStart_toStartOf="@+id/imgGou1"
                            app:layout_constraintTop_toBottomOf="@+id/imgGou1" />

                        <TextView
                            android:id="@+id/vipTbg3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:gravity="start"
                            android:text="@string/faster_generation"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:maxWidth="200dp"
                            android:textStyle="bold"
                            android:textAppearance="@style/font_11"
                            android:textColor="@color/colorBlack"
                            app:layout_constraintBottom_toBottomOf="@+id/imgGou3"
                            app:layout_constraintStart_toEndOf="@+id/imgGou3"
                            app:layout_constraintTop_toTopOf="@+id/imgGou3" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgGou4"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/img_vip_icon_select"
                            android:tint="@color/colorBlack"
                            app:layout_constraintStart_toEndOf="@+id/vipTbg3"
                            app:layout_constraintTop_toTopOf="@+id/imgGou3" />

                        <TextView
                            android:id="@+id/vipTbg4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:gravity="start"
                            android:textStyle="bold"
                            android:layout_marginEnd="20dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/mine_vip_all_templates4"
                            android:textAppearance="@style/font_11"
                            android:textColor="@color/colorBlack"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="@+id/imgGou4"
                            app:layout_constraintStart_toEndOf="@+id/imgGou4"
                            app:layout_constraintTop_toTopOf="@+id/imgGou4" />


                        <TextView
                            android:id="@+id/tvContinue"
                            bindSingleClick="@{()->handler.onVipClick()}"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_btn_mine_vip"
                            android:drawableEnd="@drawable/img_vip_more_w"
                            android:drawablePadding="5dp"
                            android:drawableTint="@color/colorWhite"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:text="@string/mine_vip_continue"
                            android:textAppearance="@style/font_12"
                            android:textColor="@color/colorFontWhite"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:id="@+id/linePoint"
                        bindSingleClick="@{()->handler.onPoint()}"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/conVip">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_hash_w"
                            app:tint="@color/colorWhite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/hash_points"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/img_icon_hash32" />

                        <TextView
                            android:id="@+id/tvFlops"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:textAppearance="@style/font_14"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent"
                            tools:text="500" />

                        <androidx.appcompat.widget.AppCompatImageView
                            bindVisible="@{!gvm.isTodayChecked()}"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_mine_history_msg" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_more_w"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>

                    <View
                        android:id="@+id/viewpoint"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorWhite10"
                        app:layout_constraintTop_toBottomOf="@+id/linePoint" />

                    <LinearLayout
                        android:id="@+id/lineHistory"
                        bindSingleClick="@{()->handler.onHistoryClick()}"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/viewpoint">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_mine_icon_history"
                            app:tint="@color/colorWhite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/mine_generation_history"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageView
                            bindVisible="@{gvm.userInfo.newTaskNum!=0}"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_mine_history_msg" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_more_w"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        bindAdapter="@{vm.meHistoryHAdapter}"
                        bindData="@{vm.historyList}"
                        bindVisible="@{vm.historyList.size()>0}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/margin_width_app"
                        android:paddingBottom="12dp"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@+id/lineHistory"
                        tools:listitem="@layout/item_mine_h" />

                    <LinearLayout
                        android:id="@+id/lineCollect"
                        bindSingleClick="@{()->handler.onCollectClick()}"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/recyclerView">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_saved41"
                            app:tint="@color/colorWhite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/mine_collect"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_more_w"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lineBrowsing"
                        bindSingleClick="@{()->handler.onBrowsing()}"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/lineCollect">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_browsing_w"
                            app:tint="@color/colorWhite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start|center_vertical"
                            android:text="@string/browsing_history"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_more_w"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>

                    <View
                        android:id="@+id/view1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorWhite10"
                        app:layout_constraintTop_toBottomOf="@+id/lineBrowsing" />


                    <LinearLayout
                        android:id="@+id/lineVip"
                        bindSingleClick="@{()->handler.onVipClick()}"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/view1">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_mine_icon_pro"
                            app:tint="@color/colorWhite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/mine_pro_member"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_more_w"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/lineMyFace"
                        bindSingleClick="@{()->handler.onMyFaceClick()}"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/lineVip">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/mine_my_face"
                            app:tint="@color/colorWhite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/mine_my_face"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:tint="@color/colorWhite" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_more_w"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>

                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorWhite10"
                        app:layout_constraintTop_toBottomOf="@+id/lineMyFace" />

                    <LinearLayout
                        android:id="@+id/lineShare"
                        bindSingleClick="@{()->handler.onMyShareClick()}"
                        bindVisible="@{gvm.isOpenShare()}"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/view">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/mine_my_share"
                            app:tint="@color/colorWhite" />

                        <TextView
                            android:id="@+id/tvShare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:text="@string/mine_my_share"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:tint="@color/colorWhite" />

                        <androidx.appcompat.widget.AppCompatImageView
                            bindVisible="@{gvm.isShowTool()!=0}"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:src="@drawable/img_mine_icon_free" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_more_w"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lineGroup"
                        bindSingleClick="@{()->handler.onGroup()}"
                        bindVisible="@{gvm.isShowTool != 0}"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/lineShare">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_group"
                            app:tint="@color/colorWhite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/join_vip_group"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_more_w"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lineTelegram"
                        bindSingleClick="@{()->handler.onTelegram()}"
                        bindVisible="@{gvm.isShowTool != 0}"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/lineGroup">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_telegram"
                            app:tint="@color/colorWhite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/telegram_group"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_more_w"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lineFeedback"
                        bindSingleClick="@{()->handler.onFeedbackClick()}"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/lineTelegram">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_operations"
                            app:tint="@color/colorWhite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/mine_feedback"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageView
                            bindVisible="@{gvm.hasNewFeedbackMsg}"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:background="@drawable/bg_mine_history_msg" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_more_w"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linePrivacy"
                        bindSingleClick="@{()->handler.onPolicyClick()}"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@+id/lineFeedback">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_mine_privacy"
                            app:tint="@color/colorWhite" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/mine_user_privacy_policy"
                            android:textAppearance="@style/font_16"
                            android:textColor="@color/colorWhite"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_width_app"
                            android:src="@drawable/img_icon_more_w"
                            app:tint="@color/colorWhite" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>