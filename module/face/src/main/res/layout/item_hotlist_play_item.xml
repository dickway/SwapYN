<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="isState"
            type="Integer" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="4dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCover"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/img_default_m"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="115:152"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/shape_round_8dp"
            app:strokeColor="@null"
            tools:srcCompat="@tools:sample/avatars" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgTou"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="5dp"
            android:background="@drawable/img_default_m"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/shape_circle"
            app:strokeColor="@null"
            tools:srcCompat="@tools:sample/avatars" />

        <com.google.android.material.imageview.ShapeableImageView
            bindVisible="@{isState==3||isState==4}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#80000000"
            android:scaleType="center"
            android:src="@drawable/img_icon_play_error"
            app:layout_constraintBottom_toBottomOf="@+id/imgCover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/imgCover"
            app:shapeAppearanceOverlay="@style/shape_round_8dp"
            app:strokeColor="@null" />

        <TextView
            bindVisible="@{isState==1||isState==0}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/colorBgBlack50"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/production_title"
            android:textAppearance="@style/font_14"
            android:textColor="@color/colorWhite"
            app:layout_constraintBottom_toBottomOf="@+id/imgCover"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/imgCover" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgOperate"
            android:layout_width="10dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:scaleType="fitXY"
            android:src="@drawable/img_icon_operate2"
            android:tint="@color/colorWhite"
            app:layout_constraintEnd_toEndOf="@+id/imgCover"
            app:layout_constraintTop_toTopOf="@+id/imgCover" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="8dp"
            android:text="2024/5/28"
            android:textAppearance="@style/font_11"
            android:textColor="@color/colorWhite"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>