<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="12dp" />
            <padding android:left="16dp" android:right="16dp" />
            <solid android:color="@color/colorWhite10" />
            <stroke android:width="1dp" android:color="@color/colorWhite" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape>
            <corners android:radius="12dp" />
            <padding android:left="16dp" android:right="16dp" />
            <solid android:color="@color/colorWhite10" />
            <stroke android:width="1dp" android:color="@color/colorWhite" />
        </shape>
    </item>
    <item android:state_checked="false" android:state_selected="false">
        <shape>
            <padding android:left="0dp" android:right="0dp" />
            <solid android:color="#00000000" />
            <stroke android:width="0dp" android:color="@color/colorBlack" />
        </shape>
    </item>
</selector>