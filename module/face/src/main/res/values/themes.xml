<resources xmlns:tools="http://schemas.android.com/tools">

    //夜间模式主题

    <style name="Theme.Main" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash_bg</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <style name="Theme.Bottom" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="colorPrimary">@color/colorAppBg</item>
        <item name="colorPrimaryDark">@color/colorAppBg</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:colorBackground">@color/colorAppBg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="colorPrimary">@color/colorAppBg</item>
        <item name="colorPrimaryDark">@color/colorAppBg</item>
        <item name="colorAccent">@color/colorFont6</item>
        <item name="android:navigationBarColor">@color/colorAppBg</item>
        <item name="android:colorBackground">@color/colorAppBg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.Zoom" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="openImage.background">@color/colorAppBg</item>
        <item name="openImage.statusBar.fontStyle">dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="scstyle" parent="Theme.AppCompat.Light">
        <!--开启时的颜色-->
        <item name="colorControlActivated">#FFFFFF</item>
        <!--关闭时的颜色-->
        <item name="colorSwitchThumbNormal">#FFFFFF</item>
        <!--关闭时的轨迹颜色-->
        <item name="android:colorForeground">#80FFFFFF</item>
    </style>


    <style name="Theme.Detail" parent="AppTheme">
        <item name="alertDialogTheme">@style/GoogleCastDialog</item>
        <item name="dialogTheme">@style/GoogleCastDialog</item>
    </style>

    <style name="GoogleCastDialog" parent="ThemeOverlay.AppCompat.Dark">
        <item name="colorPrimary">#40423f</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

</resources>