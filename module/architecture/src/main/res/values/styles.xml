<resources>

    <style name="ImmersiveTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="BottomDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_slide_up</item>
        <item name="android:windowExitAnimation">@anim/dialog_slide_down</item>
    </style>

    <style name="RightDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_slide_right</item>
        <item name="android:windowExitAnimation">@anim/dialog_slide_left</item>
    </style>
</resources>
